    - count_ref[7] + NET count_ref[7] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 -500 ) ( 140 500 )
        + FIXED ( 199870 500 ) N ;
END PINS
END DESIGN
